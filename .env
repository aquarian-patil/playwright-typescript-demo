# ==============================================
# ENVIRONMENT CONFIGURATION
# ==============================================
# Copy this file to .env and update values
# DO NOT commit .env file to version control
# ==============================================

# Environment
NODE_ENV=development
ENV=dev

# ==============================================
# UI APPLICATION URLS
# ==============================================

# OrangeHRM
ORANGEHRM_BASE_URL=https://opensource-demo.orangehrmlive.com
ORANGEHRM_USERNAME=Admin
ORANGEHRM_PASSWORD=admin123

# SauceDemo
SAUCEDEMO_BASE_URL=https://www.saucedemo.com
SAUCEDEMO_USERNAME=standard_user
SAUCEDEMO_PASSWORD=secret_sauce

# Default Base URL (used by Playwright config)
BASE_URL=https://opensource-demo.orangehrmlive.com

# ==============================================
# API ENDPOINTS
# ==============================================

# ReqRes API
REQRES_BASE_URL=https://reqres.in/api

# DummyJSON API
DUMMYJSON_BASE_URL=https://dummyjson.com
DUMMYJSON_USERNAME=emilys
DUMMYJSON_PASSWORD=emilyspass

# JSONPlaceholder API
JSONPLACEHOLDER_BASE_URL=https://jsonplaceholder.typicode.com

# Petstore API
PETSTORE_BASE_URL=https://petstore.swagger.io/v2

# Default API Base URL
API_BASE_URL=https://reqres.in/api

# ==============================================
# BROWSER CONFIGURATION
# ==============================================

# Browser type: chromium, firefox, webkit
BROWSER=chromium

# Headless mode: true, false
HEADLESS=true

# Browser channel: chrome, msedge, chrome-beta, msedge-beta, msedge-dev
CHANNEL=chrome

# Slow motion (milliseconds)
SLOW_MO=0

# ==============================================
# TEST EXECUTION CONFIGURATION
# ==============================================

# Number of parallel workers
WORKERS=4

# Retry attempts for failed tests
RETRIES=1

# Test timeout (milliseconds)
TEST_TIMEOUT=60000

# Action timeout (milliseconds)
ACTION_TIMEOUT=15000

# Navigation timeout (milliseconds)
NAVIGATION_TIMEOUT=30000

# ==============================================
# REPORTING CONFIGURATION
# ==============================================

# Screenshot on failure: on, off, only-on-failure
SCREENSHOT=only-on-failure

# Video recording: on, off, retain-on-failure, on-first-retry
VIDEO=retain-on-failure

# Trace: on, off, retain-on-failure, on-first-retry
TRACE=retain-on-failure

# Report directory
REPORT_DIR=reports

# Allure results directory
ALLURE_RESULTS_DIR=allure-results

# Allure report directory
ALLURE_REPORT_DIR=allure-report

# ==============================================
# LOGGING CONFIGURATION
# ==============================================

# Log level: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info

# Log directory
LOG_DIR=logs

# Log file name pattern
LOG_FILE_PATTERN=application-%DATE%.log

# Log max size (e.g., 20m for 20MB)
LOG_MAX_SIZE=20m

# Log max files (number of days to retain)
LOG_MAX_FILES=14d

# Console logging: true, false
LOG_CONSOLE=true

# ==============================================
# DATA CONFIGURATION
# ==============================================

# Test data directory
DATA_DIR=data

# Use Faker for random data: true, false
USE_FAKER=true

# Faker locale: en, en_US, de, fr, es, etc.
FAKER_LOCALE=en

# ==============================================
# CI/CD CONFIGURATION
# ==============================================

# CI environment indicator
CI=false

# ==============================================
# ADVANCED CONFIGURATION
# ==============================================

# Viewport width
VIEWPORT_WIDTH=1920

# Viewport height
VIEWPORT_HEIGHT=1080

# Locale
LOCALE=en-US

# Timezone
TIMEZONE=America/New_York

# Device scale factor
DEVICE_SCALE_FACTOR=1

# User agent (leave empty for default)
USER_AGENT=

# Ignore HTTPS errors: true, false
IGNORE_HTTPS_ERRORS=true

# Accept downloads: true, false
ACCEPT_DOWNLOADS=true

# Download path
DOWNLOAD_PATH=downloads

# ==============================================
# ENCRYPTION & SECURITY
# ==============================================

# Encryption key for sensitive data (generate using crypto)
ENCRYPTION_KEY=your-32-character-encryption-key

# Encryption algorithm
ENCRYPTION_ALGORITHM=aes-256-cbc

# ==============================================
# CUSTOM CONFIGURATION
# ==============================================
# Add your custom environment variables below
# ==============================================
